    <string name="yt_r31_archive_auto_script">Skript automatisch erstellen</string>
    <string name="yt_r31_archive_auto_script_summary">Bei verschwundenen Videos, aus dem Transkript. Nutzt deinen KI-Anbieter und kostet Geld. Aus: der Knopf je Eintrag. Ton von Videos mit hohem Risiko wird immer analysiert (höchstens 5 am Tag), wenn ein KI-Anbieter eingerichtet ist.</string>
    <string name="yt_r31_archive_ai_risk">KI-Einschätzung</string>
    <string name="yt_r31_archive_ai_risk_summary">Der Risiko-Schätzer fragt zu neuen Videos auch deinen KI-Anbieter (Titel, Kanal, Beschreibung). Kostet Geld.</string>
