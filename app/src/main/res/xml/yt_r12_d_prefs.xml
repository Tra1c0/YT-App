<?xml version="1.0" encoding="utf-8"?>
<!-- YT: settings of package D (the home screens), a section of "Gesten & Interaktion". Hidden while
     it holds no setting. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="yt_r12_d_category"
        app:title="@string/yt_r12_d_category">

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_swipe_gesture"
            android:summary="@string/yt_home_card_swipe_summary"
            app:defaultValue="true"
            app:key="yt_card_swipe"
            app:title="@string/yt_home_card_swipe" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_queue"
            android:summary="@string/yt_home_drag_summary"
            app:defaultValue="true"
            app:key="yt_home_drag"
            app:title="@string/yt_home_drag" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_yt_timer"
            android:summary="@string/yt_timebox_chip_summary"
            app:defaultValue="true"
            app:key="yt_timebox_chip"
            app:title="@string/yt_timebox_chip" />

        <ListPreference
            android:icon="@drawable/ic_yt_intent_browse"
            android:summary="@string/yt_intent_ask_summary"
            app:defaultValue="after30"
            app:entries="@array/yt_intent_ask_entries"
            app:entryValues="@array/yt_intent_ask_values"
            app:key="yt_intent_ask"
            app:title="@string/yt_intent_ask" />

        <com.github.libretube.ui.yt.feed.YtPausedChannelsPreference
            android:icon="@drawable/ic_yt_pause_week"
            app:key="yt_paused_channels_list"
            app:persistent="false"
            app:title="@string/yt_home_paused_channels" />

        <com.github.libretube.ui.yt.feed.YtHiddenVideosPreference
            android:icon="@drawable/ic_yt_hide"
            app:key="yt_hidden_videos_list"
            app:persistent="false"
            app:title="@string/yt_home_hidden_videos" />

    </PreferenceCategory>

</PreferenceScreen>
