<?xml version="1.0" encoding="utf-8"?>
<!-- YT: settings of package D (the home screens), a section of "Gesten & Interaktion". Hidden while
     it holds no setting. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="yt_r12_d_category"
        app:title="@string/yt_r12_d_category">

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_swipe_gesture"
            android:summary="@string/yt_home_card_swipe_summary"
            app:defaultValue="true"
            app:key="yt_card_swipe"
            app:title="@string/yt_home_card_swipe" />

        <com.github.libretube.ui.yt.feed.YtSwipeSensitivityPreference
            android:dependency="yt_card_swipe"
            android:icon="@drawable/ic_yt_tune"
            app:key="yt_swipe_sensitivity_row"
            app:title="@string/yt_swipe_sensitivity" />

        <com.github.libretube.ui.yt.feed.YtSwipeFinePreference
            android:dependency="yt_card_swipe"
            android:summary="@string/yt_swipe_fine_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="true"
            app:key="yt_swipe_fine"
            app:title="@string/yt_swipe_fine" />

        <com.github.libretube.ui.yt.feed.YtSwipeValuePreference
            android:dependency="yt_swipe_fine"
            app:iconSpaceReserved="true"
            app:key="yt_swipe_angle"
            app:title="@string/yt_swipe_angle" />

        <com.github.libretube.ui.yt.feed.YtSwipeValuePreference
            android:dependency="yt_swipe_fine"
            app:iconSpaceReserved="true"
            app:key="yt_swipe_drift"
            app:title="@string/yt_swipe_drift" />

        <com.github.libretube.ui.yt.feed.YtSwipeValuePreference
            android:dependency="yt_swipe_fine"
            app:iconSpaceReserved="true"
            app:key="yt_swipe_distance"
            app:title="@string/yt_swipe_distance" />

        <com.github.libretube.ui.yt.feed.YtSwipeCalibratePreference
            android:dependency="yt_card_swipe"
            android:icon="@drawable/ic_swipe_gesture"
            android:summary="@string/yt_swipe_calibrate_summary"
            app:key="yt_swipe_calibrate_row"
            app:title="@string/yt_swipe_calibrate" />

        <com.github.libretube.ui.yt.feed.YtSwipeResetPreference
            android:dependency="yt_card_swipe"
            android:icon="@drawable/ic_reset"
            android:summary="@string/yt_swipe_reset_summary"
            app:key="yt_swipe_reset_row"
            app:title="@string/yt_swipe_reset" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_yt_eye"
            android:summary="@string/yt_seen_marks_summary"
            app:defaultValue="true"
            app:key="yt_seen_marks"
            app:title="@string/yt_seen_marks" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_queue"
            android:summary="@string/yt_home_drag_summary"
            app:defaultValue="true"
            app:key="yt_home_drag"
            app:title="@string/yt_home_drag" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_yt_timer"
            android:summary="@string/yt_timebox_chip_summary"
            app:defaultValue="true"
            app:key="yt_timebox_chip"
            app:title="@string/yt_timebox_chip" />

        <ListPreference
            android:icon="@drawable/ic_yt_intent_browse"
            android:summary="@string/yt_intent_ask_summary"
            app:defaultValue="after30"
            app:entries="@array/yt_intent_ask_entries"
            app:entryValues="@array/yt_intent_ask_values"
            app:key="yt_intent_ask"
            app:title="@string/yt_intent_ask" />

        <com.github.libretube.ui.yt.feed.YtPausedChannelsPreference
            android:icon="@drawable/ic_yt_pause_week"
            app:key="yt_paused_channels_list"
            app:persistent="false"
            app:title="@string/yt_home_paused_channels" />

        <com.github.libretube.ui.yt.feed.YtHiddenVideosPreference
            android:icon="@drawable/ic_yt_hide"
            app:key="yt_hidden_videos_list"
            app:persistent="false"
            app:title="@string/yt_home_hidden_videos" />

    </PreferenceCategory>

</PreferenceScreen>
