<?xml version="1.0" encoding="utf-8"?>
<!-- YT: settings of package C (the player gestures), a section of "Gesten & Interaktion". Hidden while
     it holds no setting. Read when a gesture begins (YtPlayerGesturePrefs). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="yt_r12_c_category"
        app:title="@string/yt_r12_c_category">

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_frame"
            android:summary="@string/yt_r12_c_magnifier_summary"
            app:defaultValue="true"
            app:key="yt_scrub_magnifier"
            app:title="@string/yt_r12_c_magnifier_title" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_video"
            android:summary="@string/yt_r12_c_live_picture_summary"
            app:defaultValue="true"
            android:dependency="yt_scrub_magnifier"
            app:key="yt_scrub_live_picture"
            app:title="@string/yt_r12_c_live_picture_title" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_rewind"
            android:summary="@string/yt_r12_c_return_chip_summary"
            app:defaultValue="true"
            app:key="yt_return_chip"
            app:title="@string/yt_r12_c_return_chip_title" />

    </PreferenceCategory>

</PreferenceScreen>
