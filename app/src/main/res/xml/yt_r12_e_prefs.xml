<?xml version="1.0" encoding="utf-8"?>
<!-- YT: settings of package E (the comments that follow the scene), a section of "Gesten & Interaktion". Hidden while
     it holds no setting. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="yt_r12_e_category"
        app:title="@string/yt_r12_e_category">

        <!-- CommentScene.PREF_KEY; the chips above the comments change it too -->
        <ListPreference
            android:icon="@drawable/ic_comment"
            app:defaultValue="off"
            app:entries="@array/yt_r12_e_scene_entries"
            app:entryValues="@array/yt_r12_e_scene_values"
            app:key="yt_comments_scene"
            app:title="@string/yt_r12_e_scene_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
