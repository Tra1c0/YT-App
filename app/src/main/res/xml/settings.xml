<?xml version="1.0" encoding="utf-8"?>
<!-- YT: settings grouped into everyday settings and settings for tinkering. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- YT: the guide comes first: it explains the rest and is not a setting itself -->
    <Preference
        android:icon="@drawable/ic_help"
        app:key="yt_guide"
        app:summary="@string/yt_guide_summary"
        app:title="@string/yt_guide_title" />

    <PreferenceCategory app:title="@string/yt_settings_everyday">

        <Preference
            android:icon="@drawable/ic_color"
            app:key="appearance"
            app:summary="@string/appearance_summary"
            app:title="@string/appearance" />

        <Preference
            android:icon="@drawable/ic_play_filled"
            app:key="player"
            app:summary="@string/player_summary"
            app:title="@string/player" />

        <!-- YT: gestures and haptics of round 12 -->
        <Preference
            android:icon="@drawable/ic_swipe_gesture"
            app:key="yt_interaction"
            app:summary="@string/yt_interaction_summary"
            app:title="@string/yt_interaction" />

        <Preference
            android:icon="@drawable/ic_block"
            app:key="sponsorblock"
            app:summary="@string/sponsorblock_summary"
            app:title="@string/sponsorblock" />

        <Preference
            android:icon="@drawable/ic_backup"
            app:key="backup_restore"
            app:summary="@string/backup_restore_summary"
            app:title="@string/backup_restore" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/yt_settings_geeks">

        <Preference
            android:icon="@drawable/ic_settings"
            android:summary="@string/general_summary"
            app:key="general"
            app:title="@string/general" />

        <Preference
            android:icon="@drawable/ic_movie"
            app:key="audio_video"
            app:summary="@string/audio_video_summary"
            app:title="@string/audio_video" />

        <Preference
            android:icon="@drawable/ic_server"
            app:key="account"
            app:summary="@string/instance_summary"
            app:title="@string/account" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:icon="@drawable/ic_update"
            app:key="update"
            app:summary="@string/version"
            app:title="@string/update_summary" />

        <!-- YT: one page for both kinds of notifications (YT builds, new videos), next to the
             update check; the update rows that were here live there now (NotificationSettings) -->
        <Preference
            android:icon="@drawable/ic_notification"
            app:key="notifications"
            app:summary="@string/yt_r30_notify_entry_summary"
            app:title="@string/notifications" />

        <Preference
            android:icon="@drawable/ic_info"
            app:key="crashlog"
            app:title="@string/crashlog"/>

        <!-- YT: storage page (cache sizes, clear) -->
        <Preference
            android:icon="@drawable/ic_delete"
            app:key="yt_storage"
            app:summary="@string/yt_storage_summary"
            app:title="@string/yt_storage_title" />

        <!-- YT: diagnosis page (build, update result, network, crash reports) -->
        <Preference
            android:icon="@drawable/ic_device"
            app:key="yt_diagnosis"
            app:summary="@string/yt_diag_summary"
            app:title="@string/yt_diag_title" />

    </PreferenceCategory>

</PreferenceScreen>
