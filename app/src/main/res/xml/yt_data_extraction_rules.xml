<?xml version="1.0" encoding="utf-8"?>
<!-- YT: backups and device transfers (Android 12 and later) never carry the YouTube session, the update push address or the archive (large media) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yt_account.xml" />
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="sharedpref" path="yt_newssum.xml" />
        <exclude domain="sharedpref" path="yt_push.xml" />
        <exclude domain="database" path="unifiedpush-connector" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="yt_archive/" />
        <exclude domain="sharedpref" path="yt_archive.xml" />
        <!-- SSI: the semantic model (about 135 MB), the benchmark files and the index (rebuilt from the feed) would break the backup quota; saved researches stay -->
        <exclude domain="file" path="yt_ssi/model/" />
        <exclude domain="file" path="yt_ssi/bench/" />
        <exclude domain="database" path="yt_ssi.db" />
        <exclude domain="database" path="yt_ssi.db-wal" />
        <exclude domain="database" path="yt_ssi.db-shm" />
        <exclude domain="database" path="yt_ssi.db-journal" />
        <exclude domain="file" path="yt_crash/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yt_account.xml" />
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="sharedpref" path="yt_newssum.xml" />
        <exclude domain="sharedpref" path="yt_push.xml" />
        <exclude domain="database" path="unifiedpush-connector" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="yt_archive/" />
        <exclude domain="sharedpref" path="yt_archive.xml" />
        <!-- SSI: the semantic model (about 135 MB), the benchmark files and the index (rebuilt from the feed) would break the backup quota; saved researches stay -->
        <exclude domain="file" path="yt_ssi/model/" />
        <exclude domain="file" path="yt_ssi/bench/" />
        <exclude domain="database" path="yt_ssi.db" />
        <exclude domain="database" path="yt_ssi.db-wal" />
        <exclude domain="database" path="yt_ssi.db-shm" />
        <exclude domain="database" path="yt_ssi.db-journal" />
        <exclude domain="file" path="yt_crash/" />
    </device-transfer>
</data-extraction-rules>
