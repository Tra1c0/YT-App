<?xml version="1.0" encoding="utf-8"?>
<!-- YT: "SSI-Suche" (round 33): the moments search. Sizes and states are filled by YtSsiSettings. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="yt_ssi_main"
        app:title="@string/yt_r33_ssi_title">

        <Preference
            android:icon="@drawable/ic_yt_ssi"
            app:key="yt_ssi_model"
            app:title="@string/yt_r33_ssi_model" />

        <Preference
            android:icon="@drawable/ic_save"
            app:key="yt_ssi_index"
            app:selectable="false"
            app:title="@string/yt_r33_ssi_index" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_history"
            app:defaultValue="true"
            app:key="yt_ssi_background"
            app:summary="@string/yt_r33_ssi_background_summary"
            app:title="@string/yt_r33_ssi_background" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_text"
            app:defaultValue="true"
            app:key="yt_ssi_feed"
            app:summary="@string/yt_r33_ssi_feed_summary"
            app:title="@string/yt_r33_ssi_feed" />

        <ListPreference
            android:icon="@drawable/ic_history"
            app:defaultValue="30"
            app:entries="@array/yt_r38_ssi_window_entries"
            app:entryValues="@array/yt_r38_ssi_window_values"
            app:key="yt_ssi_window_days"
            app:title="@string/yt_r38_ssi_window"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:icon="@drawable/ic_movie"
            app:defaultValue="6"
            app:entries="@array/yt_ssi_budget_values"
            app:entryValues="@array/yt_ssi_budget_values"
            app:key="yt_ssi_deep_budget"
            app:title="@string/yt_r33_ssi_budget"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_info"
            app:defaultValue="false"
            app:key="yt_ssi_allow_ai"
            app:summary="@string/yt_r33_ssi_allow_ai_summary"
            app:title="@string/yt_r33_ssi_allow_ai" />

        <!-- SSI-2 (round 35) -->
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_info"
            app:defaultValue="true"
            app:dependency="yt_ssi_allow_ai"
            app:key="yt_ssi_ai_rerank"
            app:summary="@string/yt_r35_ssi_rerank_summary"
            app:title="@string/yt_r35_ssi_rerank" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_history"
            app:defaultValue="true"
            app:key="yt_ssi_learn"
            app:summary="@string/yt_r35_ssi_learn_summary"
            app:title="@string/yt_r35_ssi_learn" />

        <Preference
            android:icon="@drawable/ic_close"
            app:key="yt_ssi_learn_reset"
            app:title="@string/yt_r35_ssi_learn_reset" />

        <Preference
            android:icon="@drawable/ic_download_folder"
            app:key="yt_ssi_index_now"
            app:summary="@string/yt_r33_ssi_index_now_summary"
            app:title="@string/yt_r33_ssi_index_now" />

        <Preference
            android:icon="@drawable/ic_history"
            app:key="yt_ssi_rebuild"
            app:summary="@string/yt_r33_ssi_rebuild_summary"
            app:title="@string/yt_r33_ssi_rebuild" />

        <Preference
            android:icon="@drawable/ic_close"
            app:key="yt_ssi_clear"
            app:summary="@string/yt_r33_ssi_clear_index_summary"
            app:title="@string/yt_r33_ssi_clear_index" />

    </PreferenceCategory>

    <!-- SSI-3 (round 37): relations with verified quotes ("Belege") -->
    <PreferenceCategory
        app:key="yt_ssi_evidence"
        app:title="@string/yt_r37_ssi_settings_title">

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_info"
            app:defaultValue="true"
            app:dependency="yt_ssi_allow_ai"
            app:key="yt_ssi_stance"
            app:summary="@string/yt_r37_ssi_stance_summary"
            app:title="@string/yt_r37_ssi_stance" />

        <ListPreference
            android:icon="@drawable/ic_movie"
            app:defaultValue="3"
            app:dependency="yt_ssi_stance"
            app:entries="@array/yt_ssi_stance_per_search_values"
            app:entryValues="@array/yt_ssi_stance_per_search_values"
            app:key="yt_ssi_stance_per_search"
            app:title="@string/yt_r37_ssi_per_search"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:icon="@drawable/ic_history"
            app:defaultValue="30"
            app:dependency="yt_ssi_stance"
            app:entries="@array/yt_ssi_stance_per_day_values"
            app:entryValues="@array/yt_ssi_stance_per_day_values"
            app:key="yt_ssi_stance_per_day"
            app:title="@string/yt_r37_ssi_per_day"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:icon="@drawable/ic_save"
            app:key="yt_ssi_stance_info"
            app:selectable="false"
            app:title="@string/yt_r37_ssi_stance_info" />

    </PreferenceCategory>

    <!-- SSI-2 (round 35): the benchmark on the user's own verified examples -->
    <PreferenceCategory
        app:key="yt_ssi_bench"
        app:title="@string/yt_r35_ssi_bench_title">

        <Preference
            android:icon="@drawable/ic_download_folder"
            app:key="yt_ssi_bench_import"
            app:title="@string/yt_r35_ssi_bench_import" />

        <Preference
            android:icon="@drawable/ic_yt_ssi"
            app:key="yt_ssi_bench_run"
            app:title="@string/yt_r35_ssi_bench_run" />

        <!-- round 36: sweep the meaning cut-off on the same examples -->
        <Preference
            android:icon="@drawable/ic_history"
            app:key="yt_ssi_bench_calibrate"
            app:title="@string/yt_r36_ssi_calibrate" />

        <Preference
            android:icon="@drawable/ic_info"
            app:key="yt_ssi_bench_format"
            app:summary="@string/yt_r35_ssi_bench_format_summary"
            app:title="@string/yt_r35_ssi_bench_format" />

    </PreferenceCategory>
</PreferenceScreen>
