<?xml version="1.0" encoding="utf-8"?>
<!-- YT: the explanation loop's sheet (YtLoopSheet): its ends, speed and pause, the chapter as a
     loop and the loops used before on this video. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/standard_bottom_sheet"
        style="@style/Widget.Material3.BottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drag handle for accessibility -->
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:id="@+id/drag_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/yt_r12_c_loop_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:targetApi="p" />

                    <!-- A and B, large, with digits that keep their width -->
                    <TextView
                        android:id="@+id/loop_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorPrimary"
                        tools:text="A 1:23 – B 1:45" />

                    <TextView
                        android:id="@+id/loop_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Durchgang 3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loop_set_a"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/yt_r12_c_loop_set_a" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loop_set_b"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/yt_r12_c_loop_set_b" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loop_chapter"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:text="@string/yt_r12_c_loop_chapter"
                        app:icon="@drawable/ic_repeat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/yt_r12_c_loop_speed"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/loop_speeds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checkedChip="@id/loop_speed_100"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_speed_100"
                            style="@style/Chip"
                            tools:text="1×" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_speed_75"
                            style="@style/Chip"
                            tools:text="0,75×" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_speed_50"
                            style="@style/Chip"
                            tools:text="0,5×" />

                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/yt_r12_c_loop_pause"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/loop_pauses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checkedChip="@id/loop_pause_0"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_pause_0"
                            style="@style/Chip"
                            android:text="@string/yt_r12_c_loop_pause_none" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_pause_2"
                            style="@style/Chip"
                            tools:text="2 s" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_pause_4"
                            style="@style/Chip"
                            tools:text="4 s" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/loop_pause_8"
                            style="@style/Chip"
                            tools:text="8 s" />

                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/loop_saved_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/yt_r12_c_loop_saved"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/loop_saved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loop_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="52dp"
                        android:text="@string/yt_r12_c_loop_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loop_end"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="52dp"
                        android:text="@string/yt_r12_c_loop_end"
                        android:visibility="gone"
                        app:icon="@drawable/ic_close" />

                    <TextView
                        android:id="@+id/loop_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/yt_r12_c_loop_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
