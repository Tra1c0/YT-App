<?xml version="1.0" encoding="utf-8"?>
<!-- YT: Movo search, magnifier in a dark circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="32dp"
                android:height="32dp" />
            <solid android:color="#FF1E1E22" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_yt_search"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp" />
</layer-list>
